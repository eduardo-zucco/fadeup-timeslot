# MySQL externo (fora do compose) — ajuste host/credenciais para o seu banco
USER_MYSQL_FADEUP=fadeup
PASS_MYSQL_FADEUP=troque-esta-senha
HOST_MYSQL_FADEUP=host.docker.internal
PORT_MYSQL_FADEUP=3306
BASE_MYSQL_FADEUP=fadeup

# Autenticação (JWT) — segredo forte e pepper fixo das senhas
JWT_SECRET=troque-por-um-segredo-forte-de-32-bytes
PASSWORD_PEPPER=KANVOASJO1239BLAS01238995N
ACCESS_TOKEN_MINUTES=30
REFRESH_USER_HOURS=2
APP_REFRESH_DAYS=7

# URL pública da API usada pelo frontend em BUILD TIME (VITE_API_BASE).
# Em acesso local use http://localhost:8000; em servidor, a URL pública da API.
VITE_API_BASE=http://localhost:8000

# Credenciais da aplicação (front) — correspondem a um registro em service_credentials.
VITE_APP_CLIENT_ID=front-app
VITE_APP_CLIENT_SECRET=troque-pelo-client-secret-gerado

# Origens autorizadas por CORS no backend (onde o frontend é servido)
FRONT_ORIGINS=http://localhost:8080
