server {
    listen 80;
    server_name manage-control-dev.com.br www.manage-control-dev.com.br;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name manage-control-dev.com.br www.manage-control-dev.com.br;

    ssl_certificate /etc/letsencrypt/live/www.manage-control-dev.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.manage-control-dev.com.br/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Grafana (mantido)
    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # API do fadeUp -> backend (uvicorn na 8000, só no localhost)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check do backend (opcional, útil para checagens)
    location = /healthy_check {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # Frontend fadeUp (nginx do container na 8080, só no localhost)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
