# HTTPS automático (Let's Encrypt). {$DOMAIN} vem do ambiente do compose.
{$DOMAIN} {
	encode gzip

	# API: tudo sob /api vai para o backend (porta interna 8000)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Health check do backend exposto para o deploy conferir
	handle /healthy_check {
		reverse_proxy backend:8000
	}

	# Demais rotas: aplicação React (nginx interno na 8080)
	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
